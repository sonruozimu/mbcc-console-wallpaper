{
  "name": "dsh-theme-mbcc-console-ext",
  "version": "0.2.0",
  "description": "MBCC console theme for DSH with an opening-video boot sequence and a local wallpaper library (upload, slideshow, opacity, page themes).",
  "license": "MIT",
  "author": "sonruozimu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonruozimu/mbcc-console-wallpaper.git"
  },
  "homepage": "https://github.com/sonruozimu/mbcc-console-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/sonruozimu/mbcc-console-wallpaper/issues"
  },
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "theme",
    "wallpaper",
    "mbcc"
  ]
}
